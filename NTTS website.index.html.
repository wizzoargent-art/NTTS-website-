<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NTTS Namibia Enterprise</title>
<script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 text-gray-900">

<!-- NAV -->
<header class="bg-black text-white p-4 flex justify-between">
  <h1 class="font-bold text-xl">NTTS Namibia</h1>
  <button onclick="openAdmin()" class="text-sm bg-orange-500 px-3 py-1 rounded">
    Admin
  </button>
</header>

<!-- HERO -->
<section class="p-10 text-center bg-cover bg-center text-white"
style="background-image:url('https://images.unsplash.com/photo-1501785888041-af3ef285b470');">

  <div class="bg-black/60 p-10 rounded-xl">
    <h2 class="text-4xl font-bold">Explore Namibia with Confidence</h2>
    <p class="mt-2">4x4 Rentals • Safaris • Travel Experiences</p>
  </div>

</section>

<!-- VEHICLES -->
<section class="p-8">
  <h2 class="text-2xl font-bold mb-4">Available Vehicles</h2>

  <div class="grid md:grid-cols-3 gap-4">

    <div class="bg-white p-4 rounded shadow">
      <h3 class="font-bold">Toyota Hilux 4x4</h3>
      <p>N$ 1200 / day</p>
      <button onclick="book('Hilux')" class="bg-green-600 text-white px-3 py-2 mt-2 rounded">
        Book Now
      </button>
    </div>

    <div class="bg-white p-4 rounded shadow">
      <h3 class="font-bold">Land Cruiser</h3>
      <p>N$ 1800 / day</p>
      <button onclick="book('Land Cruiser')" class="bg-green-600 text-white px-3 py-2 mt-2 rounded">
        Book Now
      </button>
    </div>

    <div class="bg-white p-4 rounded shadow">
      <h3 class="font-bold">SUV Comfort</h3>
      <p>N$ 900 / day</p>
      <button onclick="book('SUV')" class="bg-green-600 text-white px-3 py-2 mt-2 rounded">
        Book Now
      </button>
    </div>

  </div>
</section>

<!-- BOOKING FORM -->
<section class="p-8 bg-white">
  <h2 class="text-2xl font-bold mb-4">Quick Booking</h2>

  <input id="name" placeholder="Full Name" class="border p-2 w-full mb-2">
  <input id="phone" placeholder="Phone Number" class="border p-2 w-full mb-2">
  <input id="dates" placeholder="Dates (e.g. 10-15 June)" class="border p-2 w-full mb-2">
  <input id="vehicle" placeholder="Vehicle Selected" class="border p-2 w-full mb-2">

  <button onclick="submitBooking()" class="bg-orange-500 text-white px-4 py-2 rounded">
    Submit Booking
  </button>
</section>

<!-- BOOKINGS PREVIEW -->
<section class="p-8">
  <h2 class="text-xl font-bold">Live Bookings (Demo)</h2>
  <div id="list" class="mt-4 space-y-2"></div>
</section>

<!-- ADMIN PANEL -->
<div id="adminPanel" class="hidden fixed top-0 left-0 w-full h-full bg-black/80 p-10">
  <div class="bg-white p-6 rounded max-w-xl mx-auto">

    <h2 class="text-xl font-bold">Admin Login</h2>
    <input id="adminPass" placeholder="Enter password" class="border p-2 w-full mt-2">

    <button onclick="login()" class="bg-black text-white px-4 py-2 mt-2">
      Login
    </button>

    <div id="adminContent" class="hidden mt-4">
      <h3 class="font-bold">All Bookings</h3>
      <div id="adminList"></div>
    </div>

    <button onclick="closeAdmin()" class="mt-4 text-red-500">Close</button>

  </div>
</div>

<script>
let bookings = JSON.parse(localStorage.getItem("bookings")) || [];

// BOOK VEHICLE BUTTON
function book(vehicle){
  document.getElementById("vehicle").value = vehicle;
  window.scrollTo(0, document.body.scrollHeight);
}

// SUBMIT BOOKING
function submitBooking(){
  let b = {
    name: document.getElementById("name").value,
    phone: document.getElementById("phone").value,
    dates: document.getElementById("dates").value,
    vehicle: document.getElementById("vehicle").value
  };

  bookings.push(b);
  localStorage.setItem("bookings", JSON.stringify(bookings));

  render();

  // WhatsApp message
  let msg = `NTTS BOOKING:%0AName: ${b.name}%0APhone: ${b.phone}%0AVehicle: ${b.vehicle}%0ADates: ${b.dates}`;
  window.open(`https://wa.me/264813409433?text=${msg}`, "_blank");

  alert("Booking submitted!");
}

// RENDER BOOKINGS
function render(){
  let list = document.getElementById("list");
  list.innerHTML = "";

  bookings.forEach(b => {
    list.innerHTML += `
      <div class="bg-white p-2 shadow rounded">
        ${b.name} - ${b.vehicle} - ${b.dates}
      </div>
    `;
  });

  renderAdmin();
}

// ADMIN
function openAdmin(){
  document.getElementById("adminPanel").classList.remove("hidden");
}

function closeAdmin(){
  document.getElementById("adminPanel").classList.add("hidden");
}

function login(){
  let pass = document.getElementById("adminPass").value;
  if(pass === "ntts123"){
    document.getElementById("adminContent").classList.remove("hidden");
    renderAdmin();
  } else {
    alert("Wrong password");
  }
}

function renderAdmin(){
  let adminList = document.getElementById("adminList");
  adminList.innerHTML = "";

  bookings.forEach((b,i) => {
    adminList.innerHTML += `
      <div class="border p-2 mt-2">
        <b>${b.name}</b> | ${b.vehicle} | ${b.dates}
        <button onclick="deleteBooking(${i})" class="text-red-500 ml-2">Delete</button>
      </div>
    `;
  });
}

function deleteBooking(i){
  bookings.splice(i,1);
  localStorage.setItem("bookings", JSON.stringify(bookings));
  render();
}

// INIT
render();
</script>

</body>
</html>
